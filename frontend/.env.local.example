# Backend URL used by the Next.js API routes (server-side only)
RAG_BACKEND_URL=http://127.0.0.1:8000

# Public API origin embedded into static web/mobile builds.
NEXT_PUBLIC_BACKEND_URL=
NEXT_PUBLIC_BACKEND_CONFIG_URL=
SITE_URL=

# Optional GitHub OAuth. Register this exact callback URL in your OAuth App.
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_CALLBACK_URL=http://localhost:3000/api/connectors/github/callback
# GITHUB_OAUTH_SCOPE=read:user

# Optional Stripe Payment Link for operator-fulfilled Premium early access.
# Configure recurring pricing and confirm how paid customers receive access
# before enabling this link. This route does not grant in-app entitlements.
# RESO_PREMIUM_PAYMENT_LINK=
