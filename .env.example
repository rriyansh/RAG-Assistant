# ============================================================
# WHICH LLM SHOULD ANSWER? Pick ONE from the list below.
# Every option below has a FREE tier.
# ============================================================
#   openai     -> paid, but most reliable (needs OPENAI_API_KEY)
#   groq       -> FREE, super fast (needs GROQ_API_KEY)
#   gemini     -> FREE, generous limits (needs GEMINI_API_KEY)
#   openrouter -> FREE models (needs OPENROUTER_API_KEY)
#   ollama     -> FREE, runs on YOUR laptop (needs Ollama installed)
#   custom     -> your own server (any OpenAI-compatible endpoint)
LLM_PROVIDER=nvidia
# Container/backend listen port. Most hosting platforms supply PORT at runtime.
PORT=8000
# Public API origin embedded in static Capacitor builds; replace with your tunnel hostname.
NEXT_PUBLIC_BACKEND_URL=
# Optional stable, public Gist raw URL containing {"backend_url":"https://...trycloudflare.com"}.
NEXT_PUBLIC_BACKEND_CONFIG_URL=
# Capgo account API token for GitHub Actions OTA bundles; keep local copy only in ignored .env.
CAPGO_TOKEN=

# ============================================================
# SUPABASE AUTH (optional) — OAuth Login via Supabase Auth (Google, GitHub).
# Leave blank to keep anonymous/local mode (backward compatible).
# Create a project at https://supabase.com, enable the providers you want in
# Authentication → Providers (Google, GitHub), and add your app's redirect
# callback URL (e.g. https://your-app/auth/callback) to each provider's OAuth
# console AND to Supabase's redirect URL allowlist.
# These are public client values; the OAuth secrets live in Supabase only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local development only; create a Gist and a token with gist scope. Never commit real values.
GH_GIST_ID=
GH_GIST_TOKEN=
# Set this secret on the backend host to sponsor chat for visitors.
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
XAI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=

# ============================================================
# API KEYS — only fill the one you are actually using.
# Leave the others blank; they are ignored.
# ============================================================
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Ollama doesn't need a real key. Just make sure Ollama is running:
#   ollama serve
#   ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# Custom provider (only used if LLM_PROVIDER=custom)
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=

# ============================================================
# EMBEDDINGS — how chunks become searchable numbers.
# ============================================================
#   openai -> paid, high quality (text-embedding-3-small)
#   ollama -> FREE, local (nomic-embed-text)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL_OPENAI=text-embedding-3-small
EMBEDDING_MODEL_OLLAMA=nomic-embed-text

# ============================================================
# VECTOR STORE
# ============================================================
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=documents

# ============================================================
# CHUNKING
# ============================================================
CHUNK_SIZE=400
CHUNK_OVERLAP=50
TOP_K=8

# ============================================================
# FREE WEB SEARCH — no API key required
# ============================================================
# Uses free metasearch with a Wikipedia fallback.
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=4
# If local confidence is below this, also search the web
WEB_FALLBACK_THRESHOLD=0.40

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=INFO
# Comma-separated fixed browser origins; Quick Tunnel and Vercel/Pages hosts are allowed by the default origin regex.
CORS_ALLOW_ORIGINS=
# Override only if you operate a different trusted dynamic hosting/tunnel domain.
CORS_ALLOW_ORIGIN_REGEX=^https://([a-z0-9-]+\.)*(trycloudflare\.com|vercel\.app|pages\.dev|workers\.dev)$
