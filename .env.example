# ============================================================
# WHICH LLM SHOULD ANSWER? Pick ONE from the list below.
# Every option below has a FREE tier.
# ============================================================
#   openai     -> paid, but most reliable (needs OPENAI_API_KEY)
#   groq       -> FREE, super fast (needs GROQ_API_KEY)
#   gemini     -> FREE, generous limits (needs GEMINI_API_KEY)
#   openrouter -> FREE models (needs OPENROUTER_API_KEY)
#   ollama     -> FREE, runs on YOUR laptop (needs Ollama installed)
#   custom     -> your own server (any OpenAI-compatible endpoint)
LLM_PROVIDER=groq

# ============================================================
# API KEYS — only fill the one you are actually using.
# Leave the others blank; they are ignored.
# ============================================================
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Ollama doesn't need a real key. Just make sure Ollama is running:
#   ollama serve
#   ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# Custom provider (only used if LLM_PROVIDER=custom)
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=

# ============================================================
# EMBEDDINGS — how chunks become searchable numbers.
# ============================================================
#   openai -> paid, high quality (text-embedding-3-small)
#   ollama -> FREE, local (nomic-embed-text)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL_OPENAI=text-embedding-3-small
EMBEDDING_MODEL_OLLAMA=nomic-embed-text

# ============================================================
# VECTOR STORE
# ============================================================
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=documents

# ============================================================
# CHUNKING
# ============================================================
CHUNK_SIZE=400
CHUNK_OVERLAP=50
TOP_K=8

# ============================================================
# FREE WEB SEARCH — no API key required
# ============================================================
# Uses free metasearch with a Wikipedia fallback.
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=4
# If local confidence is below this, also search the web
WEB_FALLBACK_THRESHOLD=0.40

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=INFO
