# Copy to ~/.cloudflared/config.yml after creating a named tunnel and routing
# resso-gateway.example.com in Cloudflare DNS.
tunnel: REPLACE_WITH_TUNNEL_UUID
credentials-file: /Users/REPLACE_WITH_USER/.cloudflared/REPLACE_WITH_TUNNEL_UUID.json

ingress:
  - hostname: resso-gateway.example.com
    service: http://localhost:8000
  - service: http_status:404
